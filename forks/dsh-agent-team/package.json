{
  "name": "@local/dsh-agent-team-fork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Official Agent Teams runtime, tools, management, capacity, and Web UI in one installable profile bundle fork",
  "license": "MIT",
  "engines": {
    "dsh": "0.2.2-alpha.2"
  },
  "main": "dist/host/runtime.js",
  "exports": {
    ".": "./dist/host/runtime.js",
    "./tools": "./dist/host/tools.js",
    "./management": "./dist/host/management.js",
    "./capacity": "./dist/host/capacity.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**",
    "packages/**",
    "management/**",
    "scripts/**",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-brand": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "zod": "4.4.3"
  },
  "peerDependenciesMeta": {},
  "icon": "./packages/experimental/agent-team-profile/icon.svg"
}
