  "private": true,
  "type": "module",
  "description": "Show newest-created Team tasks and subagents first without changing stored order.",
  "engines": { "dsh": "0.2.2-alpha.2" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
