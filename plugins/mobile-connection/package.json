{
  "name": "@local/dsh-mobile-connection",
  "version": "0.2.0",
  "engines": { "dsh": "0.2.2-alpha.2" },
  "private": true,
  "type": "module",
  "dependencies": { "@deepseek-ai/schemastery": "3.18.6-alpha.1", "qrcode": "1.5.4" },
  "description": "Prepare a controlled private mobile connection to the existing DSH Web GUI.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "probe-resource.mjs",
    "probe-transport.mjs",
    "proxy.mjs",
    "private-proxy.mjs",
    "serve-runtime.mjs",
    "mobile-runtime.mjs",
    "configuration.mjs",
    "trust-configuration.mjs",
    "trusted-hosts.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
