{
  "name": "@local/phanthy-dsh-bundle",
  "version": "0.2.0",
  "description": "Opt-in Phanthy model route through a local gateway",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
