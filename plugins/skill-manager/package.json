{
  "name": "@local/dsh-skill-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only inventory of skills in user and registered workspace directories",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "engines": { "dsh": "0.2.2-alpha.2" },
  "dependencies": { "@deepseek-ai/dsh-skill-filesystem": "0.2.2-alpha.2" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
