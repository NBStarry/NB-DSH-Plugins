import test from 'node:test'
import assert from 'node:assert/strict'
import { apply, createBacklog } from './host.js'

function table() {
  const records = new Map()
  return {
    records,
    get(key) { return records.get(key) },
    async put(key, value) { await new Promise(resolve => setTimeout(resolve, 2)); records.set(key, structuredClone(value)) },
  }
}
const create = title => ({ action: 'create', title })
test('isolates sessions, survives reopening, validates and performs mutations', async () => {
  const store = table()
  const backlog = createBacklog(store, { uuid: () => 'id-1', now: () => '2026-01-01T00:00:00.000Z' })
  assert.deepEqual(await backlog.run('a', { action: 'list' }), { ok: true, items: [] })
  const first = await backlog.run('a', create('  hello  '))
  assert.deepEqual(first.items[0], { id: 'id-1', title: 'hello', details: '', status: 'pending', revision: 1, createdAt: '2026-01-01T00:00:00.000Z', updatedAt: '2026-01-01T00:00:00.000Z' })
  assert.deepEqual((await backlog.run('b', { action: 'list' })).items, [])
  assert.equal((await createBacklog(store).run('a', { action: 'list' })).items[0].title, 'hello')
  assert.equal((await backlog.run('a', create(' '))).error.code, 'invalid_request')
  assert.equal((await backlog.run('a', { action: 'list', sessionId: 'b' })).error.code, 'invalid_request')
  assert.equal((await backlog.run('a', { action: 'update', id: 'id-1', expectedRevision: 1, status: 'done' })).items[0].revision, 2)
  assert.equal((await backlog.run('a', { action: 'delete', id: 'id-1', expectedRevision: 1 })).error.code, 'conflict')
  assert.equal((await backlog.run('a', { action: 'delete', id: 'id-1', expectedRevision: 2 })).items.length, 0)
  assert.equal((await backlog.run('a', { action: 'delete', id: 'id-1', expectedRevision: 2 })).error.code, 'not_found')
})

test('concurrent create and CAS are serialized, failures leave state intact', async () => {
  const store = table()
  let serial = 0
  const backlog = createBacklog(store, { uuid: () => String(++serial) })
  const created = await Promise.all(Array.from({ length: 20 }, (_, i) => backlog.run('a', create(`item ${i}`))))
  assert.equal(created.at(-1).items.length, 20)
  const id = created.at(-1).items[0].id
  const results = await Promise.all(['one', 'two'].map(title => backlog.run('a', { action: 'update', id, expectedRevision: 1, title })))
  assert.equal(results.filter(result => result.ok).length, 1)
  assert.equal(results.find(result => !result.ok).error.code, 'conflict')
  assert.equal((await backlog.run('a', { action: 'list' })).items.length, 20)
  const prior = await backlog.run('a', { action: 'list' })
  store.put = async () => { throw new Error('disk failure') }
  await assert.rejects(backlog.run('a', create('failure')), /disk failure/)
  assert.deepEqual(await backlog.run('a', { action: 'list' }), prior)
})

test('limit rejects creates but permits editing and deletion even when over limit', async () => {
  const store = table()
  const items = Array.from({ length: 101 }, (_, index) => ({ id: String(index), title: `item ${index}`, details: '', status: 'pending', revision: 1, createdAt: '2026-01-01T00:00:00.000Z', updatedAt: '2026-01-01T00:00:00.000Z' }))
  store.records.set('a', { items })
  const backlog = createBacklog(store)
  assert.equal((await backlog.run('a', create('overflow'))).error.code, 'limit_reached')
  assert.equal((await backlog.run('a', { action: 'update', id: '0', expectedRevision: 1, status: 'done' })).ok, true)
  assert.equal((await backlog.run('a', { action: 'delete', id: '0', expectedRevision: 2 })).items.length, 100)
})

test('registered command and tool share operations and scope to caller session', async () => {
  const store = table()
  let cmd, tool, closed = false
  const ctx = {
    storageDomain: { async open(spec) { assert.equal(spec.name, 'session_backlog'); return { table: () => store, close: async () => { closed = true } } } },
    effect(fn) { const cleanup = fn(); this.cleanups.push(cleanup); return cleanup }, cleanups: [],
    commands: { register(def) { cmd = def; return () => {} } },
    tools: { register(def) { tool = def; return () => {} } },
  }
  await apply(ctx)
  assert.equal(cmd.recordInput, false)
  const a = { id: 'a' }, b = { id: 'b' }
  const created = JSON.parse((await cmd.handler({ agent: a, rawInput: JSON.stringify(create('from human')) })).text)
  const listed = await tool.execute({ action: 'list' }, { agent: a })
  assert.deepEqual(listed, created)
  assert.equal((await tool.execute({ action: 'list' }, { agent: b })).items.length, 0)
  assert.throws(() => tool.execute({ action: 'list' }, {}), /owning agent/)
  assert.equal((await cmd.handler({ agent: a, rawInput: '{' })).kind, 'error')
  for (const cleanup of ctx.cleanups.reverse()) await cleanup()
  assert.equal(closed, true)
})
