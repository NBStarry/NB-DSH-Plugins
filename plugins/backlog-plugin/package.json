{
  "name": "@local/dsh-session-backlog",
  "version": "1.0.0",
  "description": "A session-scoped requirements backlog for people and agents.",
  "private": true,
  "type": "module",
  "dependencies": {
    "zod": "4.4.3"
  },
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["host.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
