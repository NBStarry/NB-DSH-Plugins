{
  "name": "@local/dsh-team-roles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Persistent editable roles for native Agent Teams.",
  "engines": { "dsh": "0.2.2-alpha.2" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "core.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dependencies": { "zod": "4.4.3" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-conversation"] }
  }
}
