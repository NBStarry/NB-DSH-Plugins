{
  "name": "@local/dsh-team-only",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Team coordination policy and controlled second-level delegation.",
  "engines": { "dsh": "0.2.2-alpha.2" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "core.js", "hierarchy.js", "coordination.js", "config.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dependencies": { "@deepseek-ai/schemastery": "3.18.6-alpha.1" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-settings-plugins"] }
  }
}
